@model IEnumerable<AkademikBilgiYonetimSistemi.Models.PatentListesi>

@{
    ViewData["Title"] = "Index";
}

<span class="label" style="background-color:#7bafd5; float: left; font-size:18px; margin-left: 17px; margin-top: 16px;">PATENTLER</span>
<br />
<br />
<hr />

<div class="container-fluid-patent">
    
    <div class="row-patent">
        <!--Controller kısmında veritabanından çektiğimiz bilgilerin projeler sayfasında kullanılması-->
        @foreach (var item in Model)
        {
            <div class="container-fluid-patent">
                <div id="callout-stacked-modals-patent" class="bs-callout-patent bs-callout-warning-patent">
                    <h4>@Html.DisplayFor(modelItem => item.PatentAdi)</h4>
                    <div class="yazarlar-patent">
                        <p>Patent Başvuru Sahipleri: <strong><font color="blue">@Html.DisplayFor(modelItem => item.BasvuruSahipleri)</font></strong> </p>
                        <p> Patent Buluş Sahipleri: <font color="blue">@Html.DisplayFor(modelItem => item.BulusSahipleri)</font></p>
                    </div>
                    <p>
                        <span class="label" style="background-color:#2e629c;">@Html.DisplayFor(modelItem => item.Kategori)</span> <span class="label" style="background-color:#7b7896">@Html.DisplayFor(modelItem => item.DosyaTipi)</span>

                    </p>

                </div>
            </div>
        }
        </div>
        </div>
