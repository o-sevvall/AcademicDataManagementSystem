        <h4 style="font-size: 24px; font-weight: bold; font-family: 'Times New Roman', Times, serif; margin-top: 50px;">
            Metrikler
        </h4>

    </font>
    <hr />
    <!--Diğer Metrikler Bölümü-->
    <button class="btn-metrikler btn-primary" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight" aria-controls="offcanvasRight">Diğer Metrikler</button>

    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
        <div class="offcanvas-header">

            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        
        <!--High Chart-->
