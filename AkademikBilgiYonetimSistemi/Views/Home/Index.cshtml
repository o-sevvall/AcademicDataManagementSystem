                <p class="text-center1" style="position: absolute;color: black;margin-top: 19%;margin-left: 45%;font-size: 22px;font-weight: 600;">@ViewBag.projeSayisi</p>
            </a>
        </button>
        <button class='btn-danisman'>
            <a href="~/TezDanismanListesi">
                <i class="fa-solid fa-pen" style="position:absolute; font-size:22px; font-weight: 600; color:black; margin-top: -27%; margin-left: -4%;"></i>
                <p class="text-center" style="position: absolute; margin-top: -4%; margin-left: 5%; font-size: 20px; font-weight: 600; color: black;">Tez Danışmanlıklar</p>
                <p class="text-center1" style="position: absolute;color: black;margin-top: 19%;margin-left: 45%;font-size: 22px;font-weight: 600;">@ViewBag.danismanlikSayisi</p>
            </a>
        </button>
        <button class='btn-patent'>
            <a href="~/PatentListesi">
                <i class="fa-solid fa-signature" style="position:absolute; font-size:22px; font-weight: 600; color:black; margin-top: -27%; margin-left: -4%;"></i>
                <p class="text-center" style="position: absolute; margin-top: -4%; margin-left: 30%; font-size: 20px; font-weight: 600; color: black;">Patentler</p>
                <p class="text-center1" style="position: absolute;color: black;margin-top: 19%;margin-left: 45%;font-size: 22px;font-weight: 600;">@ViewBag.patentSayisi</p>
            </a>
        </button>



    </div>
    <!--Anasayfada bulunan akademik görevler kısmının dizaynı ve bilgilerin veritabanından çekilmesi-->
    <font color="#7bafd5">
        <h4 style="font-size: 24px; font-weight: bold; font-family: 'Times New Roman', Times, serif; margin-top: 50px; text-align:left; margin-left:40px;">
            Akademik Görevler
        </h4>
    </font>
    <hr />
    <div class="container-fluid-akademikGorev py-5">
        <div class="row-akademikGorev">
            <div class="col-lg-12">

                <div class="horizontal-timeline-akademikGorev">

                    <ul class="list-inline-akademikGorev items-akademikGorev">
                        @foreach (var item in akademikgorev)
                        {
                            <li class="list-inline-item-akademikGorev items-list-akademikGorev">
                                <div class="px-4">
                                    <div class="event-date-akademikGorev badge-akademikGorev" style="background-color:#7bafd5;">@item.Bastar1</div>
                                    <h5 class="pt-2" style="font-size: 16px; font-weight: 600; color:darkslateblue;">@item.KadroUnvanAdi</h5>
                                    <p class="text-muted-akademikGorev" style="font-size: 14px;">
                                        @item.UnivBirimAdi <br /> ,
                                        @item.Fakultebilgisi<br /> , 
                                        @item.Bolumbilgisi
                                    </p>

                                </div>
                            </li>
                        }
                    </ul>

                </div>

            </div>
        </div>

    </div>

    <!--Anasayfada bulunan öğrenim bilgileri kısmının dizaynı ve bilgilerin veritabanından çekilmesi-->
<font color="#7bafd5"><h4 style="font-size: 24px; font-weight: bold; font-family: 'Times New Roman', Times, serif;margin-top: 50px; text-align:left; margin-left:40px;">Öğrenim Bilgisi</h4></font>
    <hr />
    <div class="container-fluid-ogrenimBilgisi py-5">
        <div class="row-ogrenimBilgisi">
            <div class="col-lg-12">

                <div class="horizontal-timeline-ogrenimBilgisi">

                    <ul class="list-inline-ogrenimBilgisi items-ogrenimBilgisi">
