            <div class style="float: right; margin-right: -450px; margin-top: -281px">
                <label class="text-decoration"><span style="font-weight: 700;">MBT:</span> Mühendislik, Bilişim ve Teknoloji (ENG)</label><br>
                <label class="text-decoration"><span style="font-weight: 700;">TB:</span> Temel Bilimler (SCI)</label><br>
                <label class="text-decoration"><span style="font-weight: 700;">SB:</span> Sosyal Bilimler (SOC)</label><br>
                <label class="text-decoration"><span style="font-weight: 700;">KT:</span> Klinik Tıp (MED)</label><br>
                <label class="text-decoration"><span style="font-weight: 700;">YB:</span> Yaşam Bilimleri (LIFE)</label><br>
                <label class="text-decoration"><span style="font-weight: 700;">TÇB:</span> Tarım ve Çevre Bilimleri (AGE)</label><br>
                <label class="text-decoration"><span style="font-weight: 700;">SBB:</span> Sanat ve Beşeri Bilimler (AHCI)</label><br>
                <label class="text-decoration"><span style="font-weight: 700;">D:</span> Diğer</label>
            </div>
        </div>

        <!--Pie Chart -->
        <div class="col-lg-12">
           
            <div class="col-lg-6 col-xs-12 text-center">
                <div id="piechart_3d" style=" width: 650px; height: 550px; margin-top: 80px;  margin-left: -78px;"></div>
            </div>



            <!--Diğer metrikler panel kısmı-->
