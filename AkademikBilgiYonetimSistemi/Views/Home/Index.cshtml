<!--Radar Chart Javascript-->

<script>
    // Grafik renklerini tanımlayan bir nesne
    window.chartColors = {
        red: 'rgb(255, 99, 132)',
        orange: 'rgb(255, 159, 64)',
        yellow: 'rgb(255, 205, 86)',
        green: 'rgb(75, 192, 192)',
        blue: 'rgb(54, 162, 235)',
        purple: 'rgb(153, 102, 255)',
        grey: 'rgb(231,233,237)'
    };
    // Rastgele bir sayı üretmek için kullanılan fonksiyon
    window.randomScalingFactor = function () {
        return (Math.random() > 0.5 ? 1.0 : -1.0) * Math.round(Math.random() * 100);
    }

    var randomScalingFactor = function () {
        return Math.round(Math.random() * 100);
    };

    var wosLabels = []; // Grafik etiketlerini içerecek boş bir dizi
    var wosData = []; // Grafik verilerini içerecek boş bir dizi

    $.ajax({
        // AJAX isteği yaparak veriyi çekiyoruz
        url: '/wos.json',
        success: function (data) {
            // Gelen veri işleniyor ve wosLabels ve wosData dizilerine ekleniyor
            for (let i = 0; i < data.length; i++) {
                wosLabels.push(data[i].TopicName);
                wosData.push(data[i].PublicationCount);
            }
        }
    });

    var color = Chart.helpers.color;
    var config = {
        type: 'radar',
        data: {
            labels: wosLabels,  // Grafik etiketleri
            datasets: [{
                label: "Araştırma Alanlarına Göre Yayınlar (WoS)", // Veri seti başlığı
                backgroundColor: color(window.chartColors.blue).alpha(0.2).rgbString(),
                borderColor: window.chartColors.blue,  // Veri seti sınırlarının rengi
                pointBackgroundColor: window.chartColors.blue,  // Noktaların rengi
                data: wosData
            }]
        },
        options: {  // Grafik seçenekleri (başlık, ölçek, açıklamalar vb.)
            legend: {
                position: 'top',
                display: false
            },
            title: {
                display: true,
                text: 'Araştırma Alanlarına Göre Yayınlar (WoS)'
            },
            scale: {
                ticks: {
                    beginAtZero: true
                }
            },
            tooltips: {
                enabled: false,
                callbacks: {
                    label: function (tooltipItem, data) {
                        var datasetLabel = data.datasets[tooltipItem.datasetIndex].label || '';
                      
                        return datasetLabel + ': ' + tooltipItem.yLabel + ': ' + data.datasets[tooltipItem.datasetIndex].notes[tooltipItem.index];
                    }
                },
                custom: function (tooltip) {
                    // tooltip elemanı
                    var tooltipEl = document.getElementById('chartjs-tooltip');
                    if (!tooltipEl) {
                        tooltipEl = document.createElement('div');
                        tooltipEl.id = 'chartjs-tooltip';
                        tooltipEl.innerHTML = "<table></table>"
                        document.body.appendChild(tooltipEl);
                    }
                   
                    if (tooltip.opacity === 0) {
                        tooltipEl.style.opacity = 0;
                        return;
                    }
                   
                    tooltipEl.classList.remove('above', 'below', 'no-transform');
                    if (tooltip.yAlign) {
                        tooltipEl.classList.add(tooltip.yAlign);
                    } else {
                        tooltipEl.classList.add('no-transform');
                    }
                    function getBody(bodyItem) {
                        return bodyItem.lines;
                    }
                    // İpucu başlığı ve içeriği oluşturulur
                    if (tooltip.body) {
                        var titleLines = tooltip.title || [];
                        var bodyLines = tooltip.body.map(getBody);
                        var innerHtml = '<thead>';
                        titleLines.forEach(function (title) {
                            innerHtml += '<tr><th>' + title + '</th></tr>';
                        });
                        innerHtml += '</thead><tbody>';
                        bodyLines.forEach(function (body, i) {
                            var colors = tooltip.labelColors[i];
                            var style = 'background:' + colors.backgroundColor;
                            style += '; border-color:' + colors.borderColor;
                            style += '; border-width: 2px';
                            var span = '<span class="chartjs-tooltip-key" style="' + style + '"></span>';
                            innerHtml += '<tr><td>' + span + body + '</td></tr>';
                        });
                        innerHtml += '</tbody>';
                        var tableRoot = tooltipEl.querySelector('table');
                        tableRoot.innerHTML = innerHtml;
                    }
                    var position = this._chart.canvas.getBoundingClientRect();
                    // İpucu pozisyonu ve font stil ayarları
                    tooltipEl.style.opacity = 1;
                    tooltipEl.style.left = position.left + tooltip.caretX + 'px';
                    tooltipEl.style.top = position.top + tooltip.caretY + 'px';
                    tooltipEl.style.fontFamily = tooltip._fontFamily;
                    tooltipEl.style.fontSize = tooltip.fontSize;
                    tooltipEl.style.fontStyle = tooltip._fontStyle;
                    tooltipEl.style.padding = tooltip.yPadding + 'px ' + tooltip.xPadding + 'px';
                }
            }
        }
    };
    window.onload = function () {
        window.myRadar = new Chart(document.getElementById("canvas"), config);
    };
    var colorNames = Object.keys(window.chartColors);

</script>

<!--Pie Chart JavaScript-->

<script>
google.charts.load("current", {
  packages: ["corechart"]
});
google.charts.setOnLoadCallback(drawPieChart);


function drawPieChart() {

        $.ajax({
            // AJAX isteği yaparak veriyi çekiyoruz
            url: '/yoksis.json',
            success: function (fData) {
                var data = google.visualization.arrayToDataTable(fData);
                var options = {
                    title: "Türlerine Göre Proje Sayıları",
                    is3D: true
                };
                var chart = new google.visualization.PieChart(
                    document.getElementById("piechart_3d")
                );
                chart.draw(data, options);

            }
        });


}



</script>
