<!--Anasayfada bulunan genel bilgiler bölümünün ayarlanılması ve veri tabanından çekme-->
<div class="icerik">
    <font color="#7bafd5"><h3>Genel Bilgiler</h3></font>
    <hr />
    <font color="darkblue"><strong>Kurum Bilgileri:</strong></font>
    <span class="bilgiler">
        @ViewBag.kadro @*HomeControllerda veritabanından çekilen verilerin kullanılması*@
    </span>
    <br />
    <font color="darkblue"><strong>Araştırma Alanları:</strong></font>
    <span class="bilgiler-arastirmaAlan">
        @ViewBag.arastirmaAlani @*HomeControllerda veritabanından çekilen verilerin kullanılması*@
    </span>


    <!--Anasayfada bulunan metrikler bölümünün ayarlanılması-->
