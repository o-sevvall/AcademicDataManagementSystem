                    <div class="panel-body">
                        <div id="publicationCountByTypes_list"><p class="paragraph-style"><a class="anchor-style"><i class="fa fa-arrow-circle-right" aria-hidden="true" style="margin-right: 4px;"></i> ISI Dergilerinde Makale (28)</a></p><p class="paragraph-style"><a class="anchor-style"><i class="fa fa-arrow-circle-right" aria-hidden="true" style="margin-right: 4px;"></i> Bildiri (11)</a></p><p class="paragraph-style"><a class="anchor-style"><i class="fa fa-arrow-circle-right" aria-hidden="true" style="margin-right: 4px;"></i> Diğer Dergilerde Makale (5)</a></p></div>

