                                    <p class="text-muted-ogrenimBilgisi" style="font-size: 14px;">
                                        @item.UnvBirimAdi <br /> ,
                                        @item.Fakultebilgisi<br /> ,
                                        @item.Bolumbilgisi
                                    </p>

                                </div>
                            </li>
                        }
                    </ul>

                </div>

            </div>
        </div>

    </div>


</div>
