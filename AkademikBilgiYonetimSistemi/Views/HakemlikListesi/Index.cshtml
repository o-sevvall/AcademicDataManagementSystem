            <th>
                @Html.DisplayNameFor(model => model.AlanBilgisi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GuncellemeTarihi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AktifPasif)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AktifPasifAd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yil)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TesvPuan)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TcKimlikNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.YayinId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.KapsamId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.KapsamAd)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HakemlikTuru)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HakemlikTuruAd)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.YayinYeri)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HakemlikSayisi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.YayinDili)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.YayinDiliAdi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Ulke)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UlkeAdi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndeksId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Endeks)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AlanBilgisi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.GuncellemeTarihi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AktifPasif)
