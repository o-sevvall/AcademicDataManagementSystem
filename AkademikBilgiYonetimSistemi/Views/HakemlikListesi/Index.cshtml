@model IEnumerable<AkademikBilgiYonetimSistemi.Models.HakemlikListesi>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TcKimlikNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.YayinId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KapsamId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KapsamAd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HakemlikTuru)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HakemlikTuruAd)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.YayinYeri)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HakemlikSayisi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.YayinDili)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.YayinDiliAdi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ulke)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UlkeAdi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndeksId)
