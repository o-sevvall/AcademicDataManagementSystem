@model IEnumerable<AkademikBilgiYonetimSistemi.Models.OgrenimBilgisiListesi>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
}


<div class="container-fluid-ogrenimBilgisi py-5">
    <div class="row-ogrenimBilgisi">
        <div class="col-lg-12">

            <div class="horizontal-timeline-ogrenimBilgisi">

                <ul class="list-inline-ogrenimBilgisi items-ogrenimBilgisi">
                    @foreach (var item in Model)
                    {
                        <li class="list-inline-item-ogrenimBilgisi items-list-ogrenimBilgisi">
                            <div class="px-4">
                                <div class="event-date-ogrenimBilgisi badge-ogrenimBilgisi bg-info">@Html.DisplayFor(modelItem => item.Bastar1)-@Html.DisplayFor(modelItem => item.Bittar1)</div>
                                <h5 class="pt-2" style="font-size: 16px; font-weight: 600; color:darkslateblue; margin-top: 49px;">@Html.DisplayFor(modelItem => item.ProgramAdi)</h5>
                                <p class="text-muted-ogrenimBilgisi" style="font-size: 14px;">
                                    @Html.DisplayFor(modelItem => item.UnvBirimAdi) <br />
                                    @Html.DisplayFor(modelItem => item.Fakultebilgisi)<br />
                                    @Html.DisplayFor(modelItem => item.Bolumbilgisi)
                                </p>

                            </div>
                        </li>
                    }
                </ul>

            </div>

        </div>
    </div>

</div>









