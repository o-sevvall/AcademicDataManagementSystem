@model IEnumerable<AkademikBilgiYonetimSistemi.Models.TezDanismanListesi>

@{
    ViewData["Title"] = "Index";
}
@*Sayfanın başlığı*@
<span class="label" style="background-color:#7bafd5; float: left; font-size:18px; margin-left: 17px; margin-top: 16px;">YÖNETİLEN TEZLER</span>
<br />
<br />
<hr />

  @*Tez sayfası için div ile tablo oluşturuldu*@
<div class="table-responsive-tez">
  <div class="table-tez">
     <div class="thead-tez">
        <div class="tr-tez">
            @*Tablonun başlıkları*@
           <div class="th-tez" style="color:#5882ff">Yıl</div>
             <div class="th-tez" style="color:#5882ff">Öğrenim Türü</div>
               <div class="th-tez" style="color:#5882ff">Hazırlayan Ad-Soyad</div>
                 <div class="th-tez" style="color:#5882ff">Tez Adı</div>
                  <div class="th-tez" style="color:#5882ff">Üniversite Adı</div>
         </div>
     </div>
@foreach (var item in Model)
                    {
            @*Tablonun içerikleri*@
                        <div class="tbody-tez">
                            <div class="tr-tez">
                                <div class="td-tez" style="font-weight: 550;">@Html.DisplayFor(modelItem => item.Yil)</div>
                                <div class="td-tez" style="font-weight: 550;">&nbsp; @Html.DisplayFor(modelItem => item.TurAdi)</div>
                                <div class="td-tez" style="font-weight: 550";>&nbsp; @Html.DisplayFor(modelItem => item.YazarAdi) @Html.DisplayFor(modelItem => item.YazarSoyadi)</div>
                                <div class="td-tez" style="font-weight: 550;">@Html.DisplayFor(modelItem => item.TezAdi)</div>
                                <div class="td-tez" style="font-weight: 550;">@Html.DisplayFor(modelItem => item.UniversiteAd)</div>
                            </div>

                        </div>
}


                </div>
            </div>

  

























