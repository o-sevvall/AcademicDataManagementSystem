@model IEnumerable<AkademikBilgiYonetimSistemi.Models.AkademikGorevListesi>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid-akademikGorev py-5">
    <div class="row-akademikGorev">
        <div class="col-lg-12">

            <div class="horizontal-timeline-akademikGorev">

                <ul class="list-inline-akademikGorev items-akademikGorev">
                    @foreach (var item in Model)
                        {
                    <li class="list-inline-item-akademikGorev items-list-akademikGorev">
                        <div class="px-4">
                                <div class="event-date-akademikGorev badge-akademikGorev bg-info">@Html.DisplayFor(modelItem => item.Bastar1)</div>
                                <h5 class="pt-2" style="font-size: 16px; font-weight: 600; color:darkslateblue;">@Html.DisplayFor(modelItem => item.KadroUnvanAdi)</h5>
                            <p class="text-muted-akademikGorev" style="font-size: 14px;">
                                    @Html.DisplayFor(modelItem => item.UnivBirimAdi) <br />
                                    @Html.DisplayFor(modelItem => item.Fakultebilgisi)<br />
                                    @Html.DisplayFor(modelItem => item.Bolumbilgisi)
                            </p>
                            
                        </div>
                    </li>
                    }
                </ul>

            </div>

        </div>
    </div>

</div>

